# Keys the WEBSITE uses (server-side only). Copy to .env.local for dev; add the
# same in Vercel > Settings > Environment Variables. Set Root Directory = web so
# Vercel only reads this file (not the Python pipeline's root .env.example).

# Live "Add data" analyzer (classifies pasted reviews)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash

# Query Assistant chatbot (answers the discovery questions + free-form)
GROQ_API_KEY=
# Optional extra keys — used automatically when the first one is rate-limited
GROQ_API_KEY_2=
# GROQ_MODEL=openai/gpt-oss-20b   # current Groq production model; or openai/gpt-oss-120b (higher quality)
